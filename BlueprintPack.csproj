<Project Sdk="Microsoft.NET.Sdk">
    <!-- A Sons of the Forest mod for RedLoader. Builds against the loader and the game code that RedLoader generated
         in the game folder; none of those files are copied into the output or committed to this repository.
         Building does not touch the game folder. The game folder defaults to Steam's standard location; if yours is
         elsewhere, pass -p:GamePath="<Sons Of The Forest folder>" or put it in GamePath.user.props (not committed):
           <Project><PropertyGroup><GamePath>D:\Games\Steam\steamapps\common\Sons Of The Forest</GamePath></PropertyGroup></Project> -->
    <Import Project="GamePath.user.props" Condition="Exists('GamePath.user.props')" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>BlueprintPack</AssemblyName>
        <RootNamespace>BlueprintPack</RootNamespace>
        <Version>0.1.0</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DebugType>embedded</DebugType>
        <Deterministic>true</Deterministic>
        <!-- Record source paths as /_/ in the DLL's embedded debug information instead of this PC's folders. -->
        <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sons Of The Forest</GamePath>
        <LoaderDir>$(GamePath)\_Redloader\net10</LoaderDir>
        <GameCodeDir>$(GamePath)\_Redloader\Game</GameCodeDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- The game's code, as generated by RedLoader. -->
        <Reference Include="$(GameCodeDir)\*.dll" Private="false" />
        <!-- The loader and its SDK. -->
        <Reference Include="$(LoaderDir)\RedLoader.dll" Private="false" />
        <Reference Include="$(LoaderDir)\SonsSdk.dll" Private="false" />
        <Reference Include="$(LoaderDir)\Il2CppInterop.Runtime.dll" Private="false" />
        <Reference Include="$(LoaderDir)\Il2CppInterop.Common.dll" Private="false" />
        <Reference Include="$(LoaderDir)\0Harmony.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Research tools have their own projects. -->
        <Compile Remove="tools\**" />
        <None Remove="tools\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- RedLoader reads Mods\<AssemblyName>\manifest.json next to Mods\<AssemblyName>.dll. -->
        <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- dotnet build -c Release -t:Package: a zip laid out like the game folder (Mods\...), in dist\. -->
    <Target Name="Package" DependsOnTargets="Build">
        <PropertyGroup>
            <StageDir>$(MSBuildProjectDirectory)\dist\stage</StageDir>
            <ZipFile>$(MSBuildProjectDirectory)\dist\BlueprintPack-$(Version).zip</ZipFile>
        </PropertyGroup>
        <ItemGroup>
            <BlueprintFiles Include="Blueprints\*.json;Blueprints\*.png" />
        </ItemGroup>
        <RemoveDir Directories="$(StageDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)\Mods" />
        <Copy SourceFiles="manifest.json" DestinationFolder="$(StageDir)\Mods\BlueprintPack" />
        <Copy SourceFiles="@(BlueprintFiles)" DestinationFolder="$(StageDir)\Mods\BlueprintPack\Blueprints" />
        <Delete Files="$(ZipFile)" />
        <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipFile)" />
        <Message Importance="high" Text="Packaged $(ZipFile)" />
    </Target>

    <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(LoaderDir)\RedLoader.dll') Or !Exists('$(GameCodeDir)\Sons.dll')"
               Text="RedLoader or its generated game code was not found under '$(GamePath)'. Install RedLoader, run the game once, or pass -p:GamePath=..." />
    </Target>
</Project>
