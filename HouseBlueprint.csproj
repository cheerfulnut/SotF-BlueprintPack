<Project Sdk="Microsoft.NET.Sdk">
    <!-- A Sons of the Forest mod for RedLoader. Builds against the loader and the game code that RedLoader generated
         in the game folder; none of those files are copied into the output or committed to this repository.
         Building does not touch the game folder. Pass -p:GamePath="<Sons Of The Forest folder>" if yours differs. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>HouseBlueprint</AssemblyName>
        <RootNamespace>HouseBlueprint</RootNamespace>
        <Version>0.1.0</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DebugType>embedded</DebugType>
        <Deterministic>true</Deterministic>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sons Of The Forest</GamePath>
        <LoaderDir>$(GamePath)\_Redloader\net10</LoaderDir>
        <GameCodeDir>$(GamePath)\_Redloader\Game</GameCodeDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- The game's code, as generated by RedLoader. -->
        <Reference Include="$(GameCodeDir)\*.dll" Private="false" />
        <!-- The loader and its SDK. -->
        <Reference Include="$(LoaderDir)\RedLoader.dll" Private="false" />
        <Reference Include="$(LoaderDir)\SonsSdk.dll" Private="false" />
        <Reference Include="$(LoaderDir)\Il2CppInterop.Runtime.dll" Private="false" />
        <Reference Include="$(LoaderDir)\Il2CppInterop.Common.dll" Private="false" />
        <Reference Include="$(LoaderDir)\0Harmony.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- RedLoader reads Mods\<AssemblyName>\manifest.json next to Mods\<AssemblyName>.dll. -->
        <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(LoaderDir)\RedLoader.dll') Or !Exists('$(GameCodeDir)\Sons.dll')"
               Text="RedLoader or its generated game code was not found under '$(GamePath)'. Install RedLoader, run the game once, or pass -p:GamePath=..." />
    </Target>
</Project>
