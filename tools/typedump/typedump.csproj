<Project Sdk="Microsoft.NET.Sdk">
  <!-- Research helper: prints types with fields, properties, methods and enum values matching a pattern.
       Reads files as data only (System.Reflection.Metadata); never loads or runs the inspected assemblies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
